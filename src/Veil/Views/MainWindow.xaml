<Window x:Class="Veil.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Veil.ViewModels"
        Title="veil" Height="600" Width="920" MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- sidebar -->
        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="veil" FontSize="20" FontWeight="Bold" Margin="4,0,0,24"/>

                <TextBlock Grid.Row="1" Text="TUNNELS" FontSize="11" Foreground="{StaticResource TextDimBrush}"
                           Margin="4,0,0,8"/>

                <ListBox Grid.Row="2" ItemsSource="{Binding Profiles}" SelectedItem="{Binding Selected}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Resources>
                        <ContextMenu x:Key="ItemMenu">
                            <MenuItem Header="Remove" Command="{Binding DataContext.RemoveCommand,
                                RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"/>
                        </ContextMenu>
                    </ListBox.Resources>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource ProfileListItem}">
                            <Setter Property="ContextMenu" Value="{StaticResource ItemMenu}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ProfileViewModel}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center"
                                         Fill="{Binding State, Converter={StaticResource TunnelStateToBrushConverter}}"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Grid.Row="3" Content="Import config" Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Stretch" Margin="0,12,0,16"
                        Command="{Binding ImportCommand}"/>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Kill switch" FontSize="13"/>
                        <TextBlock Text="Block traffic if tunnel drops" FontSize="11"
                                   Foreground="{StaticResource TextDimBrush}"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" Style="{StaticResource KillSwitchToggle}"
                              IsChecked="{Binding KillSwitchEnabled}" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>

        <!-- main panel -->
        <Grid Grid.Column="1">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                <Button Style="{StaticResource ConnectCircleButton}"
                        Command="{Binding ConnectToggleCommand}"
                        Tag="{Binding Selected.State, Converter={StaticResource TunnelStateToBrushConverter}}">
                    <TextBlock Text="{Binding Selected.IsConnected, Converter={StaticResource BoolToConnectLabelConverter}}"
                               FontSize="16" FontWeight="SemiBold"/>
                </Button>

                <TextBlock Text="{Binding Selected.StatusText}" FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,24,0,4"/>

                <TextBlock Text="{Binding Selected.Name}" FontSize="14" Foreground="{StaticResource TextDimBrush}"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="{Binding Selected.Endpoint}" FontSize="12" Foreground="{StaticResource TextDimBrush}"
                           HorizontalAlignment="Center" Margin="0,2,0,0"/>

                <Grid Margin="0,32,0,0" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="IP ADDRESS" FontSize="10" Foreground="{StaticResource TextDimBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding PublicIp}" FontSize="14" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="CONNECTED" FontSize="10" Foreground="{StaticResource TextDimBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding ConnectedSince}" FontSize="14" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="14,10" Margin="0,28,0,0"
                        Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap" MaxWidth="380" TextAlignment="Center"/>
                </Border>

            </StackPanel>
        </Grid>

    </Grid>
</Window>
